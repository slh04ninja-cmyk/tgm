# ============================================================
#  BIAS FILTERS — 5 EDGES MESURABLES
#  Classés par fiabilité décroissante (testez dans cet ordre)
#  Chaque filtre est activable/désactivable indépendamment
#  Le bot combine les filtres activés pour calculer un score
#  de biais quotidien (LONG / NEUTRAL / SHORT)
# ============================================================

# ── FILTRE 1 : COT REPORT ⭐⭐⭐⭐⭐ ──────────────────────
# Commitment of Traders (CFTC) — positionnement institutionnel
# Données : CFTC.gov (code Gold = 088691), publié chaque vendredi
# Logique : Commercials hedgers = smart money
# ★ FIABILITÉ MAXIMALE : données réelles des institutions
BIAS_COT_ENABLED=true
COT_STRONG_LONG=80           # COT Index > 80 → STRONG LONG
COT_LEAN_LONG=65             # COT Index > 65 → LEAN LONG
COT_STRONG_SHORT=20          # COT Index < 20 → STRONG SHORT
COT_LEAN_SHORT=35            # COT Index < 35 → LEAN SHORT

# ── FILTRE 2 : GLD ETF FLOW ⭐⭐⭐⭐⭐ ────────────────────
# Flux quotidien du SPDR Gold Trust (plus grand ETF Or)
# Données : Yahoo Finance (ticker: GLD)
# Logique : Influx massif = achat institutionnel = bullish
# ★ DONNÉES RÉELLES : quotidiennes, pas une estimation
BIAS_GLD_ENABLED=true
GLD_STRONG_LONG=20           # Flow 5j > +20 tonnes → STRONG LONG
GLD_LEAN_LONG=10             # Flow 5j > +10 tonnes → LEAN LONG
GLD_STRONG_SHORT=-20         # Flow 5j < -20 tonnes → STRONG SHORT
GLD_LEAN_SHORT=-10           # Flow 5j < -10 tonnes → LEAN SHORT

# ── FILTRE 3 : GVZ (Gold Volatility Index) ⭐⭐⭐⭐ ───────
# CBOE Gold Volatility Index — comme le VIX mais pour l'or
# Logique : GVZ extrême = contrarian (trop de peur = bottom)
# ★ DONNÉES CBOE OFFICIELLES : indicateur contrarian fiable
BIAS_GVZ_ENABLED=true
GVZ_STRONG_LONG=25           # GVZ > 25 → peur extrême → contrarian LONG
GVZ_LEAN_LONG=20             # GVZ > 20 → peur élevée → LEAN LONG
GVZ_STRONG_SHORT=10          # GVZ < 10 → complaisance → contrarian SHORT
GVZ_LEAN_SHORT=12            # GVZ < 12 → complaisance → LEAN SHORT

# ── FILTRE 4 : FED FUNDS RATE EXPECTATIONS ⭐⭐⭐ ──────────
# Probabilité de cut/hike au prochain FOMC (CME FedWatch)
# Logique : Cut probable = taux bas = or monte
# ★ CORRÉLATION FORTE : mais proxy indirect (2Y yield)
BIAS_FED_ENABLED=true
FED_STRONG_LONG=70           # Prob cut > 70% → STRONG LONG
FED_LEAN_LONG=55             # Prob cut > 55% → LEAN LONG
FED_STRONG_SHORT=70          # Prob hike > 70% → STRONG SHORT
FED_LEAN_SHORT=55            # Prob hike > 55% → LEAN SHORT

# ── FILTRE 5 : SHANGHAI GOLD PREMIUM ⭐⭐ ─────────────────
# Différence prix Shanghai Gold Exchange vs London spot
# Logique : Premium élevé = forte demande physique Chine = bullish
# ★ ESTIMATION : proxy via ETF chinois (pas le vrai SGE premium)
BIAS_SHANGHAI_ENABLED=true
SHANGHAI_STRONG_LONG=30      # Premium > +30$/oz → STRONG LONG
SHANGHAI_LEAN_LONG=15        # Premium > +15$/oz → LEAN LONG
SHANGHAI_STRONG_SHORT=-10    # Premium < -10$/oz → STRONG SHORT
SHANGHAI_LEAN_SHORT=0        # Premium < 0$/oz → LEAN SHORT

# ── SEUILS DU SCORE COMPOSITE ─────────────────────────────
# Score total = somme des scores de chaque filtre activé
# Chaque filtre contribue : -2 (STRONG SHORT) à +2 (STRONG LONG)
# Nombre de filtres activés détermine la plage du score
BIAS_STRONG_THRESHOLD=4      # Score >= 4 → STRONG LONG (prendre BUY seulement)
BIAS_LEAN_THRESHOLD=2        # Score >= 2 → LEAN LONG (préférer BUY)
BIAS_STRONG_NEGATIVE=-4      # Score <= -4 → STRONG SHORT (prendre SELL seulement)
BIAS_LEAN_NEGATIVE=-2        # Score <= -2 → LEAN SHORT (préférer SELL)

# ── MODE STRICT vs SOUPLE ─────────────────────────────────
# STRICT : signaux contraires au biais STRONG sont REJETÉS
# SOUPLE : signaux contraires au biais STRONG sont LOGGUÉS mais acceptés
BIAS_STRICT_MODE=true
