# ============================================================
# 4. SYSTÈME MARKET + LIMIT ORDERS
# ============================================================
# Le bot ouvre 1 MARKET immédiat + N LIMIT orders pour catcher le pullback.
#
# Exemple BUY @ 3305:
#   MARKET BUY 3305  lot=0.01  (entrée immédiate)
#   LIMIT  BUY 3302  lot=0.01  (pullback -3$)
#   LIMIT  BUY 3299  lot=0.01  (pullback -6$)
#
LIMIT_ENABLED=true              # Activer les LIMIT orders
LIMIT_COUNT=2                   # Nombre de LIMIT orders (0, 1 ou 2)
LIMIT_OFFSET_1=3.0              # 1er LIMIT: prix ± ce montant (en $)
LIMIT_OFFSET_2=6.0              # 2ème LIMIT: prix ± ce montant (en $)
LIMIT_EXPIRY_MIN=30             # Expiration des LIMIT non remplies (minutes)

# ============================================================
# 5. LOTS
# ============================================================
# Lot pour chaque type de position.
# MARKET = entrée immédiate, LIMIT1/LIMIT2 = pullback.
LOT_TOTAL=0.03                  # Lot total max par signal (référence)
LOT_MARKET=0.01                 # Lot pour le MARKET
LOT_LIMIT1=0.01                 # Lot pour le LIMIT 1
LOT_LIMIT2=0.01                 # Lot pour le LIMIT 2

# ============================================================
# 6. TAKE PROFIT (TP)
# ============================================================
# TP dynamique: recalculé quand un LIMIT se remplit.
#
# Formule: TP = average_entry ± (TP_FIXED_GAIN_USD × multiplicateur / total_lot)
#
# Cas 1: MARKET seul         → multiplicateur = 1
# Cas 2: MARKET + LIMIT1     → multiplicateur = TP_MULTIPE1
# Cas 3: MARKET + L1 + L2    → multiplicateur = TP_MULTIPE2
#
# Exemple BUY @ 3305, TP_FIXED_GAIN_USD=8$, lots=0.01:
#   MK seul:    TP = 3313.00 (mouvement = 8.00$)
#   MK + L1:    TP = 3311.50 (mouvement = 8.00$, avg=3303.50)
#   MK + L1+L2: TP = 3310.00 (mouvement = 8.00$, avg=3302.00)
#
TP_FIXED_GAIN_USD=7.0          # Gain cible en $ pour 1 position
TP_PAR_DEFAUT=15.0              # TP par défaut pour signaux sans TP (MP, QA, open)
TP_MULTIPE1=1.5                 # Multiplicateur TP quand MARKET + L1 rempli
TP_MULTIPE2=2.0                 # Multiplicateur TP quand MARKET + L1 + L2 remplis

# ============================================================
# 7. STOP LOSS (SL)
# ============================================================
# Le SL est le même pour toutes les positions d'un signal.
# Il n'est JAMAIS déplacé (pas de BE, pas de trailing).
# Le pullback doit remplir les LIMITS, pas toucher le SL.
MAX_SL_USD=10.0                 # SL max en $ (0 = utiliser SL du signal)

# ============================================================
# 8. TOLÉRANCES D'ENTRÉE
# ============================================================
# Déterminent si un signal est accepté, refusé, ou LIMIT-only.
#
# ZN: prix dans zone signal → MARKET+LIMITS, au-dessus + TOL → LIMITS seules
# PU: prix dans entry ± TOLERANCE_PU → MARKET+LIMITS, au-dessus + TOL → LIMITS seules
# MP: zone = [current - TOLERANCE_MP, current] pour BUY
# QA: même logique que PU
TOLERANCE_ZN=1.0                # Tolérance au-dessus de la zone ZN (en $)
TOLERANCE_PU=3.0                # Tolérance autour du prix PU/QA (en $)
TOLERANCE_MP=5.0                # Tolérance autour du prix MP (en $)
FUSION_TOLERANCE=3.0            # Tolérance pour matcher QA avec signal complet
TP_DISTANCE_MIN_RATIO=0.3       # Ignorer si prix a parcouru > 70% vers TP

# ============================================================
# 9. FILTRES DE PROTECTION
# ============================================================
# Filtre horaire
TIME_FILTER_ENABLED=true        # Activer le filtre horaire
TRADING_START_HOUR=2            # Heure de début (UTC)
TRADING_END_HOUR=20             # Heure de fin (UTC)

# Filtre news (fenêtres par tier)
NEWS_FILTER_ENABLED=true        # Activer le filtre news
NEWS_MIN_IMPACT=high            # Impact minimum: high ou medium
NEWS_WINDOW_BEFORE_BLOCK=15     # Bloquer signaux X min avant news
NEWS_WINDOW_BEFORE_CLOSE=5      # Fermer positions X min avant news
NEWS_WINDOW_AFTER=15            # Reprendre X min après news

# Filtre TradingView (consensus 26 indicateurs)
TV_FILTER_ENABLED=false         # Activer le filtre TradingView
TV_FILTER_SYMBOL=GOLD           # Symbole TradingView
TV_FILTER_SCREENER=cfd          # Screener
TV_FILTER_EXCHANGE=TVC          # Exchange
TV_FILTER_TIMEFRAME=5m          # Timeframe: 1m, 5m, 15m, 30m, 1h, 4h, 1d
TV_FILTER_CACHE_TTL=30          # Refresh API toutes les N secondes
TV_STRONG_BUY=15                # ≥ 15 votes BUY → STRONG_BUY
TV_BUY=10                       # ≥ 10 votes BUY → BUY
TV_STRONG_SELL=15               # ≥ 15 votes SELL → STRONG_SELL
TV_SELL=10                      # ≥ 10 votes SELL → SELL
TV_NEUTRAL_ALLOW=true           # true=BUY+SELL acceptés si NEUTRAL, false=bloqués

# Filtre conflit (même canal, même symbole)
CONFLIT_FILTER_ENABLED=true     # Activer le filtre de conflit

# ============================================================
# 10. GESTION DU RISQUE
# ============================================================
MAX_POSITIONS=60                # Nombre max de signaux simultanés
MAX_SPREAD_POINTS=50            # Spread max en points
DAILY_PROFIT_LIMIT=500.0        # Objectif quotidien en $ (0 = désactivé)

# ============================================================
# 11. QUICK ALERT
# ============================================================
# Paramètres pour les signaux MP (Market Price) et QA (Quick Alert)
QUICK_ALERT_SL_OFFSET=10.0     # SL par défaut si non fourni (en $)
RR_RATIO_DEFAULT=2.0            # Risk/Reward ratio pour calculer TP

# ============================================================
# 12. PARAMÈTRES MT5
# ============================================================
MAGIC_NUMBER=20250226           # Magic number pour identifier les ordres du bot
SLIPPAGE=20                     # Slippage max en points
ORDER_EXPIRY_MINUTES=120        # Expiration des ordres pending (legacy)
POLL_INTERVAL_SEC=0.3           # Intervalle de polling en secondes

# ============================================================
# 13. ALERTES & LOGS
# ============================================================
LOG_TRADE_MANAGEMENT=false      # Logs console pour gestion des positions
ALERT_TRADE_MANAGEMENT=false    # Alertes Telegram pour gestion des positions
ALERT_DAILY_PERFORMANCE=true    # Rapport quotidien P&L → Telegram

# ============================================================
# 14. MODE DE FONCTIONNEMENT
# ============================================================
DEMO_MODE=true                  # true = démo, false = live
RUNTIME_MINUTES=0               # 0 = infini

# ============================================================
# 15. GRADE (scalping) — désactivé
# ============================================================
ACTIVE_GRADE=false
NUM_CHANEL_GRADE=1
REVERSE_PRICE=2.0
REALISED_GRADE=3.0
MAX_GRADE_POSITIONS=10
