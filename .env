# ── TELEGRAM API ────────────────────────────────────────
TG_API_ID=38469571
TG_API_HASH=4a7a530f07d7af72960787e5c53ea906

# ── LOTS ADAPTÉS À 200 $ ─────────────────────────────────
LOT_TOTAL=0.02
LOT_UNIQUE_TRADE=0.01

# ── PARAMÈTRES MT5 ─────────────────────────────────────
MAGIC_NUMBER=20250226
SLIPPAGE=20
ORDER_EXPIRY_MINUTES=120
POLL_INTERVAL_SEC=0.3

# ── GESTION DU RISQUE ────────────────────────────────────
MAX_POSITIONS=6
MAX_SPREAD_POINTS=50

# ── QUICK ALERT & GÉNÉRATION AUTO TP/SL ────────────────────
QUICK_ALERT_SL_OFFSET=10.0
DEFAULT_ALERT_TP_RR=1.0
RR_RATIO_DEFAULT=1.5
FUSION_TOLERANCE=3

# ── GAIN FIXE ───────────────────────────────────────────
TP_FIXED_ENABLED=true
TP_FIXED_GAIN_USD=10.0
PNL_TRIGGER_USD=7.0


# ── STOP LOSS  ────────────────────────────────────────
SL_PRIX_UNIQUE=12.0
SL_TOTAL=25.0

# ── TP_TRIGGER (annulation des ordres pending) ─────────────
TP_TRIGGER=3

# ── OBJECTIF QUOTIDIEN & FILTRES ──────────────────────────
DAILY_PROFIT_LIMIT=70.0
TIME_FILTER_ENABLED=true
TRADING_START_HOUR=2
TRADING_END_HOUR=20

# ── NEWS FILTER (désactivé) ───────────────────────────────
NEWS_FILTER_ENABLED=true
NEWS_WINDOW_BEFORE_BLOCK=15
NEWS_WINDOW_BEFORE_CLOSE=5
NEWS_WINDOW_AFTER=15
NEWS_MIN_IMPACT=high


# ── CONFLIT FILTRE ────────────────────────────────
CONFLIT_FILTER_ENABLED=true

# ── MODE POSITION UNIQUE ──────────────────────────────────
# true = un seul MARKET par signal (pas de LIMIT, pas de merge)
# Les signaux zone (CAS1, C2-S1, C2-S2) deviennent un seul MARKET
# Les signaux QA+Fusion ignorent le signal complet (QA seul)
# Les signaux Prix Unique S2 (LIMIT) deviennent MARKET
SINGLE_POSITION_MODE=true
# Ratio minimum de distance restante vers TP (0.3 = 30%)
# Si le prix a déjà parcouru plus de 70% du chemin vers le TP, le signal est ignoré
TP_DISTANCE_MIN_RATIO=0.3
# Tolérance de prix pour les Quick Alerts avec prix (ex: SELL 4000)
# Si le prix actuel est dans [entry ± QA_PRICE_TOLERANCE], le QA est exécuté en MARKET
# Sinon le QA est annulé
QA_PRICE_TOLERANCE=3.0
# Tolérance de prix pour les signaux Prix Unique (PU)
# PU1: prix entre entry et SL → MARKET
# PU2: prix entre entry et entry ± TOLERANCE → MARKET
# Sinon: signal annulé
PU_PRICE_TOLERANCE=3.0
# Tolérance de prix pour les signaux Zone (ZN)
# ZN1: prix entre entry et SL → MARKET
# ZN2: prix entre entry et entry ± TOLERANCE → MARKET
# Sinon: signal annulé
ZN_PRICE_TOLERANCE=3.0

# ── MODE DE FONCTIONNEMENT ────────────────────────────────
DEMO_MODE=true
RUNTIME_MINUTES=0

# ── GRADE (scalping) désactivé ─────────────────────────────
ACTIVE_GRADE=false
NUM_CHANEL_GRADE=1
REVERSE_PRICE=2.0
REALISED_GRADE=3.0
MAX_GRADE_POSITIONS=10

# ── TIMESFM ───────────────────────────────────────────
TIMESFM_ENABLED=false
TIMESFM_TIMEFRAME=M5          # M1, M5, M15, M30, H1
TIMESFM_CONTEXT_BARS=256      # historique fourni au modèle
TIMESFM_HORIZON=12            # bougies prédites
TIMESFM_MIN_MOVE_PIPS=5.0     # rejet si mouvement prédit < 5 pips
TIMESFM_MIN_CONFIDENCE=0.35   # rejet si confiance trop faible
TIMESFM_SYMBOL=XAUUSDm        # symbole exact dans MT5 Exness

# Cache TTL pour _resolve_order (en secondes, 1 recommandé)
CACHE_TTL_SECONDS=2
