# ── CANAUX TELEGRAM ────────────────────────────────────────
# OPTION A : DOSSIER TELEGRAM (recommandé)
# Le bot lit automatiquement les canaux de ce dossier Telegram.
# Crée un dossier "Trading" dans Telegram, ajoutes-y tes canaux,
# puis indique le NOM ou l'ID du dossier ci-dessous.
# Le bot affiche la liste des dossiers disponibles au démarrage.
# Plusieurs dossiers: séparer par des virgules.
# Exemples:
#   TG_FOLDER=Trading                    ← un dossier
#   TG_FOLDER=Signal,Crypto,Forex        ← plusieurs dossiers
TG_FOLDER=PU, ZN, QA
#
# OPTION B : CANAUX MANUELS (fallback si TG_FOLDER vide)
# Indique les IDs ou usernames des canaux à surveiller.
# Le bot charge dynamiquement tous les TG_CHANNEL_* trouvés.
# Pour ajouter un canal : TG_CHANNEL_N=<id>
TG_CHANNEL_1=@fxGzl                         # 1 : FxGzl
TG_CHANNEL_2=-1001506646047                 # 2 : Alixza Gold Trading
TG_CHANNEL_3=-1001707962844                 # 3 : EAGLE FOREX PESEARCH
TG_CHANNEL_4=-1001754381715                 # 4 : GOLD SNIPER
TG_CHANNEL_5=-1003186841892                 # 5 : AMELIA GOLD TRADER
TG_CHANNEL_6=-1002110233887                 # 6 : FX VIP SERVICE
TG_CHANNEL_7=-1003105562783                 # 7 : GOLD PRO SIGNALS
TG_CHANNEL_8=-1001513988436                 # 8 : XAUUSD GOLD MASTER
TG_CHANNEL_9=-1001429507314                 # 9 : ALBALOSHI FX TEAM
TG_CHANNEL_10=-1003701551347                # 10 : FX SIMONS MASTER
TG_CHANNEL_11=-1001809876773                # 11 : INSIDER TRADING
TG_CHANNEL_12=-1002479072972                # 12 : Xauusd Gold Vip
TG_CHANNEL_13=-1003659063429                # 13 : FOREX PLATO TRADING
TG_CHANNEL_14=-1001772197601                # 14 : PIPS MASTER
TG_CHANNEL_15=-1001983856587                # 15 : GOLD BASICS ACADEMY
TG_CHANNEL_16=-1001282738791                # 16 : ELIOTT WAVES
TG_CHANNEL_17=-1001964215771                # 17 : SUPER SCALPER RAYAN
TG_CHANNEL_18=-1001951939988                # 18 : XAUUSD DAILY SIGNALS

TG_ALERT_CHANNEL=@TrdReport

# ── METATRADER 5 ───────────────────────────────────────────
MT5_LOGIN=262342460
MT5_PASSWORD=Slh640538@
MT5_SERVER=Exness-MT5Trial16
MT5_PATH=C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe

# ── TELEGRAM API ───────────────────────────────────────────
TG_API_ID=38469571
TG_API_HASH=4a7a530f07d7af72960787e5c53ea906

# ── LOTS ───────────────────────────────────────────────────
LOT_TOTAL=0.02
LOT_UNIQUE_TRADE=0.01

# ── PARAMÈTRES MT5 ─────────────────────────────────────────
MAGIC_NUMBER=20250226
SLIPPAGE=20
ORDER_EXPIRY_MINUTES=120
POLL_INTERVAL_SEC=0.3

# ── GESTION DU RISQUE ─────────────────────────────────────
MAX_POSITIONS=60
MAX_SPREAD_POINTS=50

# ── QUICK ALERT ────────────────────────────────────────────
QUICK_ALERT_SL_OFFSET=10.0
RR_RATIO_DEFAULT=2.0

# ── GAIN FIXE (TP-FIXED + BE) ─────────────────────────────
TP_FIXED_ENABLED=true
TP_FIXED_GAIN_USD=8.0       # Gain cible (en $) — TP = entry ± ce montant
PNL_TRIGGER_USD=5.0         # Seuil BE — quand profit ≥ ce montant, SL → entry
BE_USD=3                    # Marge de sécurité SL (côté défavorable)

# === SL PLAFONNÉ ===
MAX_SL_USD=10.0             # Distance SL max en $ (cap le SL du signal)

# === TRAILING & PARTIAL ===
TRAILING_STOP_USD=7.0       # Trailing stop pour P3 (Trailing)
PARTIAL_TRAIL_USD=5.0       # Trailing stop pour P4b (Partial Trail)

# === P2 BE ESCALADÉ — 3 paliers ===
P2_TP_OFFSET=15.0           # TP de P2 = entry ± ce montant
P2_TRIGGER_1=4.0            # Palier 1 : déclenchement à +4$
P2_SL_OFFSET_1=0.0          # Palier 1 : SL → entry (0$)
P2_TRIGGER_2=8.0            # Palier 2 : déclenchement à +8$
P2_SL_OFFSET_2=2.0          # Palier 2 : SL → entry + 2$
P2_TRIGGER_3=12.0           # Palier 3 : déclenchement à +12$
P2_SL_OFFSET_3=5.0          # Palier 3 : SL → entry + 5$

# === P4a PARTIAL QUICK ===
P4A_TP_OFFSET=5.0           # TP de P4a = entry ± ce montant
TOLERANCE_ZN=1.0              # Tolérance autour de la zone (en $)

# === ALERTES & LOGS ===
LOG_TRADE_MANAGEMENT=false   # Logs console pour P1-P4b (BE, trailing, partial)
ALERT_TRADE_MANAGEMENT=false # Alertes Telegram pour P1-P4b
ALERT_DAILY_PERFORMANCE=true # Rapport quotidien P&L → Telegram

# ── TOLÉRANCES DE PRIX ────────────────────────────────────
# Signaux Prix Unique (PU) : PU1 (entry→SL) ou PU2 (tolérance)
PU_PRICE_TOLERANCE=3.0
# Quick Alerts avec prix : exécuté si prix dans [entry ± tolérance]
QA_PRICE_TOLERANCE=3.0
# Filtre distance TP : ignorer si prix a parcouru plus de 70% vers TP
TP_DISTANCE_MIN_RATIO=0.3
# Fusion : tolérance pour matcher QA avec signal complet
FUSION_TOLERANCE=3.0

# ── OBJECTIF QUOTIDIEN & FILTRES ──────────────────────────
DAILY_PROFIT_LIMIT=200.0
TIME_FILTER_ENABLED=true
TRADING_START_HOUR=2
TRADING_END_HOUR=20

# ── NEWS FILTER ────────────────────────────────────────────
NEWS_FILTER_ENABLED=true
NEWS_WINDOW_BEFORE_BLOCK=15
NEWS_WINDOW_BEFORE_CLOSE=5
NEWS_WINDOW_AFTER=15
NEWS_MIN_IMPACT=high

# ── NEWS TIER NFPCPI (NFP, CPI) ──────────────────────────
NEWS_WINDOW_BEFORE_BLOCK_NFPCPI=15
NEWS_WINDOW_BEFORE_CLOSE_NFPCPI=5
NEWS_WINDOW_AFTER_NFPCPI=20

# ── NEWS TIER FOMC ────────────────────────────────────────
NEWS_WINDOW_BEFORE_BLOCK_FOMC=15
NEWS_WINDOW_BEFORE_CLOSE_FOMC=5
NEWS_WINDOW_AFTER_FOMC=30

# ── NEWS TIER SPIKE (PCE, PPI, GDP, ADP, ISM, Retail) ────
NEWS_WINDOW_BEFORE_BLOCK_SPIKE=10
NEWS_WINDOW_BEFORE_CLOSE_SPIKE=5
NEWS_WINDOW_AFTER_SPIKE=10

# ── CONFLIT FILTRE ────────────────────────────────────────
CONFLIT_FILTER_ENABLED=true

# ── MODE POSITION UNIQUE ──────────────────────────────────
# Un seul MARKET par signal, jamais de LIMIT/pending
SINGLE_POSITION_MODE=true

# ── MODE DE FONCTIONNEMENT ────────────────────────────────
DEMO_MODE=true
RUNTIME_MINUTES=0

# ── GRADE (scalping) désactivé ─────────────────────────────
ACTIVE_GRADE=false
NUM_CHANEL_GRADE=1
REVERSE_PRICE=2.0
REALISED_GRADE=3.0
MAX_GRADE_POSITIONS=10

# ── TIMESFM ────────────────────────────────────────────────
TIMESFM_ENABLED=false
TIMESFM_TIMEFRAME=M5
TIMESFM_CONTEXT_BARS=256
TIMESFM_HORIZON=12
TIMESFM_MIN_MOVE_PIPS=5.0
TIMESFM_MIN_CONFIDENCE=0.35
TIMESFM_SYMBOL=XAUUSDm
